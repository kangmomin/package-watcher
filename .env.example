# package-watcher 환경 변수 예시. `.env` 로 복사해서 쓴다(docker compose 가 자동으로 읽는다).
# 값이 없는 키는 주석으로 둔다. 빈 문자열은 "설정하지 않음"과 같다.

# ---- GitHub
# 토큰은 셸에서 넘기는 것을 권장한다: GITHUB_TOKEN=$(gh auth token) docker compose up
# GITHUB_TOKEN=

# ---- 설정 초기값: DB 에 값이 없을 때(첫 실행)만 적용된다. 이후에는 GUI 설정 화면에서 바꾼다.
# GITHUB_ORG=my-org
SCAN_INTERVAL_HOURS=24
DIGEST_TIME=09:00
# EMAIL_RECIPIENTS=a@example.com,b@example.com

# ---- SMTP: SMTP_HOST 와 SMTP_FROM 이 모두 있어야 메일 발송이 켜진다.
# SMTP_HOST=smtp.example.com
# SMTP_PORT 를 비우면 SMTP_SECURE 가 참일 때 465, 아니면 587 을 쓴다.
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=package-watcher@example.com
# SMTP_SECURE=false

# ---- 서버: 로컬 실행(npm start)용. Docker 로 실행할 때는 설정하지 않는다(이미지의 값과 volume 경로가 바뀐다).
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=./data
# WEB_DIST_DIR=
